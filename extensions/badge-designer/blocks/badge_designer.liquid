{% comment %}
  Badge Designer App Block
  This block allows merchants to add a badge designer widget to their product pages
{% endcomment %}

{% comment %} Check if product has required tags {% endcomment %}
{% assign show_badge_designer = false %}

{% comment %} Check product type first {% endcomment %}
{% if block.settings.required_product_type != blank %}
  {% if product.type == block.settings.required_product_type %}
    {% assign show_badge_designer = true %}
  {% endif %}
{% comment %} If no product type specified, check tags {% endcomment %}
{% elsif block.settings.required_tags != blank %}
  {% assign required_tags = block.settings.required_tags | split: ',' %}
  {% for tag in required_tags %}
    {% assign clean_tag = tag | strip %}
    {% if product.tags contains clean_tag %}
      {% assign show_badge_designer = true %}
      {% break %}
    {% endif %}
  {% endfor %}
{% else %}
  {% assign show_badge_designer = true %}
{% endif %}

{% if show_badge_designer %}
<div class="badge-designer-block" data-block-id="{{ block.id }}">
  <div class="badge-designer-container">
    
    <!-- Header Section -->
    <div class="badge-designer-header">
      {% if block.settings.title != blank %}
        <h3 class="badge-designer-title">
          <svg class="badge-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2L13.09 8.26L20 9L13.09 9.74L12 16L10.91 9.74L4 9L10.91 8.26L12 2Z" fill="currentColor"/>
            <path d="M12 6L12.5 9.5L16 10L12.5 10.5L12 14L11.5 10.5L8 10L11.5 9.5L12 6Z" fill="white"/>
          </svg>
          {{ block.settings.title }}
        </h3>
      {% endif %}
      
      {% if block.settings.subtitle != blank %}
        <p class="badge-designer-subtitle">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>
    
    {% if block.settings.show_preview %}
      <!-- Enhanced Badge Preview -->
      <div class="badge-preview-container">
        <div class="badge-preview-wrapper">
          <div class="badge-preview" id="badge-preview-{{ block.id }}">
            <div class="badge-placeholder">
              <svg width="240" height="96" viewBox="0 0 240 96" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Badge background with gradient -->
                <defs>
                  <linearGradient id="badgeGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" style="stop-color:#ffffff;stop-opacity:1" />
                    <stop offset="100%" style="stop-color:#f8f9fa;stop-opacity:1" />
                  </linearGradient>
                  <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
                    <feDropShadow dx="2" dy="4" stdDeviation="3" flood-color="#000" flood-opacity="0.1"/>
                  </filter>
                </defs>
                
                <rect width="240" height="96" fill="url(#badgeGradient)" stroke="#e1e5e9" stroke-width="2" rx="8" filter="url(#shadow)"/>
                
                <!-- Decorative elements -->
                <circle cx="20" cy="20" r="3" fill="#007cba" opacity="0.3"/>
                <circle cx="220" cy="76" r="3" fill="#007cba" opacity="0.3"/>
                
                <!-- Text content -->
                <text x="120" y="40" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" font-weight="600" fill="#2c3e50">Your Name</text>
                <text x="120" y="65" text-anchor="middle" font-family="Arial, sans-serif" font-size="13" fill="#7f8c8d">Your Title</text>
                
                <!-- Small logo placeholder -->
                <rect x="200" y="8" width="32" height="12" fill="#007cba" opacity="0.2" rx="2"/>
                <text x="216" y="17" text-anchor="middle" font-family="Arial, sans-serif" font-size="8" fill="#007cba">LOGO</text>
              </svg>
            </div>
          </div>
          <div class="badge-preview-label">Preview</div>
        </div>
      </div>
    {% endif %}
    
    <!-- Features List -->
    {% if block.settings.show_features %}
      <div class="badge-features">
        <div class="feature-item">
          <svg class="feature-icon" width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M8 1L9.5 6L14 6L10.5 9L12 14L8 11L4 14L5.5 9L2 6L6.5 6L8 1Z" fill="#007cba"/>
          </svg>
          <span>Custom Text & Fonts</span>
        </div>
        <div class="feature-item">
          <svg class="feature-icon" width="16" height="16" viewBox="0 0 16 16" fill="none">
            <circle cx="8" cy="8" r="6" fill="#007cba"/>
          </svg>
          <span>Colors & Styles</span>
        </div>
        <div class="feature-item">
          <svg class="feature-icon" width="16" height="16" viewBox="0 0 16 16" fill="none">
            <rect x="2" y="2" width="12" height="12" fill="#007cba" rx="2"/>
          </svg>
          <span>Instant Preview</span>
        </div>
      </div>
    {% endif %}
    
    <!-- Trust indicators -->
    {% if block.settings.show_trust_indicators %}
      <div class="trust-indicators">
        <div class="trust-item">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M7 1L8.5 5.5L13 7L8.5 8.5L7 13L5.5 8.5L1 7L5.5 5.5L7 1Z" fill="#10b981"/>
          </svg>
          <span>Professional Quality</span>
        </div>
        <div class="trust-item">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M7 1L9 5L13 5L10 8L11 13L7 10L3 13L4 8L1 5L5 5L7 1Z" fill="#10b981"/>
          </svg>
          <span>Fast Delivery</span>
        </div>
      </div>
    {% endif %}
    
    <!-- Call to Action -->
    <div class="badge-designer-actions">
      <button 
        onclick="openBadgeDesignerModal('{{ product.handle | default: '' }}')"
        class="badge-designer-button badge-designer-button--{{ block.settings.button_size }}"
        style="background: linear-gradient(135deg, {{ block.settings.button_color }} 0%, {{ block.settings.button_color }}dd 100%); border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px;"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M4 4H16V16H4V4ZM6 6V14H14V6H6ZM8 8H12V10H8V8ZM8 11H12V12H8V11Z" fill="currentColor"/>
        </svg>
        {{ block.settings.button_text }}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M6 4L10 8L6 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
    
  </div>
</div>

<!-- Load Badge Designer Modal Script -->
<script src="{{ 'badge-designer-modal.js' | asset_url }}" defer></script>

{% endif %}

{% schema %}
{
  "name": "Badge Designer",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "required_tags",
      "label": "Required Product Tags",
      "info": "Comma-separated list of tags. Badge designer will only show for products with these tags. Leave empty to show on all products.",
      "placeholder": "badge-designer, customizable, personalized"
    },
    {
      "type": "text",
      "id": "required_product_type",
      "label": "Required Product Type",
      "info": "Enter the product type (e.g., 'Custom Badge', 'Badge Kit'). Badge designer will only show for products of this type. Leave empty to show on all products.",
      "placeholder": "Custom Badge, Badge Kit"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Design Your Badge"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Create professional badges with custom text, colors, and styles"
    },
    {
      "type": "text", 
      "id": "button_text",
      "label": "Button Text",
      "default": "Start Designing"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#007cba"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Button Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "checkbox",
      "id": "show_preview",
      "label": "Show Badge Preview",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_features",
      "label": "Show Features List",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_trust_indicators",
      "label": "Show Trust Indicators",
      "default": true
    }
  ]
}
{% endschema %} 