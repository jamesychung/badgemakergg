{% comment %}
  Badge Designer App Block
  This block can be added to product pages to enable badge customization
{% endcomment %}

{%- if block.settings.badge_designer_enabled -%}
  <div class="badge-designer-app-block" 
       data-shop="{{ shop.permanent_domain }}"
       data-product-id="{{ product.id }}"
       data-product-title="{{ product.title | escape }}"
       data-product-handle="{{ product.handle }}"
       style="margin: 20px 0;">
    
    <div class="badge-designer-container">
      <button 
        type="button"
        class="badge-designer-button"
        onclick="openBadgeDesignerModal('{{ product.id }}', '{{ shop.permanent_domain }}')"
        style="
          background: #007cba;
          color: white;
          border: none;
          padding: 12px 24px;
          border-radius: 6px;
          font-size: 16px;
          font-weight: 500;
          cursor: pointer;
          transition: background-color 0.2s;
        "
        onmouseover="this.style.backgroundColor='#005a87'"
        onmouseout="this.style.backgroundColor='#007cba'">
        🏷️ Design Custom Badge
      </button>
      
      <p class="badge-designer-description" style="
        margin-top: 8px;
        font-size: 14px;
        color: #666;
        margin-bottom: 0;">
        Create a personalized badge with your own text and design
      </p>
    </div>
  </div>

  {%- comment -%} Load the modal JavaScript {%- endcomment -%}
  <script src="{{ 'badge-designer-modal.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Badge Designer",
  "target": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "badge_designer_enabled",
      "label": "Enable Badge Designer",
      "default": true,
      "info": "Show badge designer on this product page"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Design Custom Badge",
      "info": "Text to display on the badge designer button"
    },
    {
      "type": "text",
      "id": "description_text",
      "label": "Description Text",
      "default": "Create a personalized badge with your own text and design",
      "info": "Description text below the button"
    }
  ]
}
{% endschema %} 