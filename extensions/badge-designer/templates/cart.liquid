{% comment %}
  Cart Template for Badge Designer
  This template handles displaying custom badge designs in the cart
{% endcomment %}

<div class="cart-page">
  {% if cart.item_count > 0 %}
    <h1>Shopping Cart</h1>
    
    <form action="/cart" method="post" novalidate>
      <table class="cart-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          {% for item in cart.items %}
            <tr class="cart-item" data-item-key="{{ item.key }}">
              <td class="cart-item-product">
                <div class="cart-item-image">
                  {% comment %} Check if this is a custom badge design {% endcomment %}
                  {% if item.properties['Custom Badge Design'] == 'Yes' and item.properties['Custom Thumbnail'] %}
                    {% comment %} Use custom thumbnail for badge designs {% endcomment %}
                    <img src="{{ item.properties['Custom Thumbnail'] }}" 
                         alt="Custom Badge Design" 
                         style="width: 80px; height: 80px; object-fit: contain; border: 1px solid #ddd; border-radius: 4px;">
                  {% else %}
                    {% comment %} Use regular product image {% endcomment %}
                    <img src="{{ item.image | img_url: '80x80' }}" 
                         alt="{{ item.title | escape }}">
                  {% endif %}
                </div>
                
                <div class="cart-item-details">
                  <h3>{{ item.product.title }}</h3>
                  
                  {% comment %} Display custom badge details if this is a custom design {% endcomment %}
                  {% if item.properties['Custom Badge Design'] == 'Yes' %}
                    <div class="badge-design-details" style="margin-top: 8px; padding: 8px; background: #f8f9fa; border-radius: 4px;">
                      <p style="margin: 0 0 4px 0; font-weight: 600; color: #333;">Custom Badge Design:</p>
                      
                      {% comment %} Display badge text lines {% endcomment %}
                      {% if item.properties['Badge Text Line 1'] != blank %}
                        <p style="margin: 2px 0; font-size: 14px;"><strong>Line 1:</strong> {{ item.properties['Badge Text Line 1'] }}</p>
                      {% endif %}
                      {% if item.properties['Badge Text Line 2'] != blank %}
                        <p style="margin: 2px 0; font-size: 14px;"><strong>Line 2:</strong> {{ item.properties['Badge Text Line 2'] }}</p>
                      {% endif %}
                      {% if item.properties['Badge Text Line 3'] != blank %}
                        <p style="margin: 2px 0; font-size: 14px;"><strong>Line 3:</strong> {{ item.properties['Badge Text Line 3'] }}</p>
                      {% endif %}
                      {% if item.properties['Badge Text Line 4'] != blank %}
                        <p style="margin: 2px 0; font-size: 14px;"><strong>Line 4:</strong> {{ item.properties['Badge Text Line 4'] }}</p>
                      {% endif %}
                      
                      {% comment %} Display design options {% endcomment %}
                      {% if item.properties['Background Color'] != blank %}
                        <p style="margin: 2px 0; font-size: 14px;"><strong>Background:</strong> {{ item.properties['Background Color'] }}</p>
                      {% endif %}
                      {% if item.properties['Backing Type'] != blank %}
                        <p style="margin: 2px 0; font-size: 14px;"><strong>Backing:</strong> {{ item.properties['Backing Type'] | capitalize }}</p>
                      {% endif %}
                      {% if item.properties['Font Family'] != blank %}
                        <p style="margin: 2px 0; font-size: 14px;"><strong>Font:</strong> {{ item.properties['Font Family'] }}</p>
                      {% endif %}
                      
                      {% comment %} Display design ID if available {% endcomment %}
                      {% if item.properties['Design ID'] != blank %}
                        <p style="margin: 2px 0; font-size: 12px; color: #666;"><strong>Design ID:</strong> {{ item.properties['Design ID'] }}</p>
                      {% endif %}
                    </div>
                  {% endif %}
                  
                  {% comment %} Display variant title if different from product title {% endcomment %}
                  {% if item.variant.title != 'Default Title' %}
                    <p style="margin: 4px 0; font-size: 14px; color: #666;">{{ item.variant.title }}</p>
                  {% endif %}
                </div>
              </td>
              
              <td class="cart-item-price">
                {{ item.final_price | money }}
              </td>
              
              <td class="cart-item-quantity">
                <input type="number" 
                       name="updates[]" 
                       value="{{ item.quantity }}" 
                       min="0" 
                       aria-label="Quantity for {{ item.product.title | escape }}"
                       style="width: 60px; padding: 4px; border: 1px solid #ddd; border-radius: 4px;">
              </td>
              
              <td class="cart-item-total">
                {{ item.final_line_price | money }}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      
      <div class="cart-actions">
        <button type="submit" name="update" class="btn btn-secondary">Update Cart</button>
        <button type="submit" name="checkout" class="btn btn-primary">Checkout</button>
      </div>
    </form>
    
    <div class="cart-summary">
      <h3>Cart Summary</h3>
      <p><strong>Subtotal:</strong> {{ cart.total_price | money }}</p>
      <p><strong>Items:</strong> {{ cart.item_count }}</p>
    </div>
    
  {% else %}
    <div class="empty-cart">
      <h1>Your cart is empty</h1>
      <p>Continue shopping to add items to your cart.</p>
      <a href="/collections/all" class="btn btn-primary">Continue Shopping</a>
    </div>
  {% endif %}
</div>

<style>
  .cart-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
  }
  
  .cart-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  
  .cart-table th,
  .cart-table td {
    padding: 12px;
    text-align: left;
    border-bottom: 1px solid #ddd;
  }
  
  .cart-table th {
    background-color: #f8f9fa;
    font-weight: 600;
  }
  
  .cart-item-product {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  
  .cart-item-image img {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 4px;
  }
  
  .cart-item-details h3 {
    margin: 0 0 8px 0;
    font-size: 16px;
  }
  
  .cart-actions {
    display: flex;
    gap: 12px;
    margin-top: 20px;
  }
  
  .btn {
    padding: 12px 24px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 16px;
    text-decoration: none;
    display: inline-block;
  }
  
  .btn-primary {
    background-color: #007cba;
    color: white;
  }
  
  .btn-secondary {
    background-color: #6c757d;
    color: white;
  }
  
  .cart-summary {
    margin-top: 20px;
    padding: 20px;
    background-color: #f8f9fa;
    border-radius: 4px;
  }
  
  .empty-cart {
    text-align: center;
    padding: 40px;
  }
  
  .badge-design-details {
    border-left: 3px solid #007cba;
  }
</style> 